<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="CRMSystemMobile.View.WorkerSchedulePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:absmodels="clr-namespace:Shared.Contracts.Absence;assembly=Shared"
    xmlns:selectors="clr-namespace:CRMSystemMobile.Selectors"
    xmlns:extensions="clr-namespace:CRMSystemMobile.Extensions"
    Title="Мое расписание"
    BackgroundColor="#112347"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="ShiftTemplate" x:DataType="extensions:ScheduleUiModel">
            <Border
                Margin="15,6"
                Padding="15"
                BackgroundColor="#213868"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Grid ColumnDefinitions="6, *" ColumnSpacing="10">
                    <BoxView
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        CornerRadius="3"
                        VerticalOptions="Fill"
                        WidthRequest="6"
                        Color="#3296F8" />

                    <Grid Grid.Column="1" RowDefinitions="Auto, Auto">
                        <Label
                            Grid.Row="0"
                            FontSize="12"
                            Text="{Binding DateTime, StringFormat='{0:dd MMMM, dddd}'}"
                            TextColor="#ACACAC" />

                        <VerticalStackLayout
                            Grid.Row="1"
                            Margin="0,5,0,0"
                            Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{Binding TimeRange}"
                                TextColor="#FFB347" />

                            <Label
                                FontSize="14"
                                Text="{Binding ShiftName}"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AbsenceTemplate" x:DataType="absmodels:AbsenceResponse">
            <Border
                Margin="15,6"
                Padding="15"
                BackgroundColor="#2A1B1B"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0">
                <Grid ColumnDefinitions="6, *" ColumnSpacing="10">
                    <BoxView
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        CornerRadius="3"
                        VerticalOptions="Fill"
                        WidthRequest="6"
                        Color="#FF9500" />

                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="*, Auto"
                        RowDefinitions="Auto, Auto">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="12"
                            TextColor="#ACACAC">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding StartDate, StringFormat='{0:dd.MM}'}" />

                                    <Span Text=" - " />

                                    <Span Text="{Binding EndDate, StringFormat='{0:dd.MM}', TargetNullValue='...'}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>

                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,5,0,0"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{Binding TypeName}"
                            TextColor="White" />

                        <Border
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Padding="8,4"
                            BackgroundColor="Transparent"
                            Stroke="#FF9500"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <Label
                                FontSize="11"
                                Text="Отсутствие"
                                TextColor="#FF9500" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <selectors:ScheduleTemplateSelector
            x:Key="ScheduleSelector"
            AbsenceTemplate="{StaticResource AbsenceTemplate}"
            ShiftTemplate="{StaticResource ShiftTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <Grid
            Grid.Row="0"
            Padding="15,10"
            ColumnDefinitions="50, *, 50"
            HeightRequest="70">
            <ImageButton
                Grid.Column="0"
                Command="{Binding GoBackCommand}"
                Source="back_icon.png" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="График"
                TextColor="White"
                VerticalOptions="Center" />
        </Grid>

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadInitialCommand}"
            IsRefreshing="{Binding IsRefreshing}"
            RefreshColor="#3296F8">

            <CollectionView
                Margin="0,10"
                ItemTemplate="{StaticResource ScheduleSelector}"
                ItemsSource="{Binding CalendarItems}"
                RemainingItemsThreshold="2"
                RemainingItemsThresholdReachedCommand="{Binding LoadNextPageCommand}">

                <CollectionView.Footer>
                    <StackLayout Padding="10" IsVisible="{Binding IsLoadingMore}">
                        <ActivityIndicator
                            HorizontalOptions="Center"
                            IsRunning="True"
                            Color="#3296F8" />
                    </StackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>