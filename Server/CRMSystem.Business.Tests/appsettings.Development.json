{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SystemDbContext": "Host=localhost;Port=5438;Database=AUTOService;Username=<DB_USER>;Password=<DB_PASSWORD>",
    "Redis": "localhost:6379"
  },
  "JwtOptions": {
    "SecretKey": "<JWT_SECRET_KEY>",
    "ExpiresHours": "12"
  },
  "Minio": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "<MINIO_ACCESS_KEY>",
    "SecretKey": "<MINIO_SECRET_KEY>",
    "BucketName": "service-files"
  }
}
